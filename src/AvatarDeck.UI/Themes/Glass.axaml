<!--
  AvatarDeck "Glass" theme: dark, translucent, rounded, softly animated.
  Real background blur is not available inside a VR overlay texture, so glass is emulated with
  layered translucent gradients and a light top border (looks the same on desktop and in VR).
  Every color is a resource so custom themes can override them.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Color x:Key="AccentColor">#8B7CFF</Color>
    <Color x:Key="AccentColor2">#4CC9F0</Color>
    <!-- Override the Fluent accent so built-in controls (sliders, combos, focus) match the theme. -->
    <Color x:Key="SystemAccentColor">#8B7CFF</Color>
    <Color x:Key="SystemAccentColorDark1">#7A6AF0</Color>
    <Color x:Key="SystemAccentColorDark2">#6858DC</Color>
    <Color x:Key="SystemAccentColorDark3">#5546C4</Color>
    <Color x:Key="SystemAccentColorLight1">#A396FF</Color>
    <Color x:Key="SystemAccentColorLight2">#BCB2FF</Color>
    <Color x:Key="SystemAccentColorLight3">#D5CEFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B5" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TileBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC857" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF5D73" />

    <LinearGradientBrush x:Key="PanelBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#E61C2030" />
      <GradientStop Offset="1" Color="#E60E1018" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
      <GradientStop Offset="1" Color="{StaticResource AccentColor2}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RailBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#14FFFFFF" />
      <GradientStop Offset="1" Color="#06FFFFFF" />
    </LinearGradientBrush>

    <CornerRadius x:Key="PanelRadius">28</CornerRadius>
    <CornerRadius x:Key="TileRadius">18</CornerRadius>
  </Styles.Resources>

  <!-- Base typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.icon">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Glass card / panel -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Widget tiles (large hit targets: comfortable with a laser pointer) -->
  <!-- A tile = sized host Panel (tileHost) + stretched control (tile) + optional overlays (star, edit layer). -->
  <Style Selector="Panel.tileHost">
    <Setter Property="Width" Value="186" />
    <Setter Property="Height" Value="104" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.tileHost.hiddenItem">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector=":is(Control).tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector=":is(ContentControl).tile">
    <Setter Property="Background" Value="{StaticResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter, ToggleButton.tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
    <Setter Property="BorderBrush" Value="#55FFFFFF" />
  </Style>
  <Style Selector="Button.tile:pressed, ToggleButton.tile:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>
  <Style Selector="ToggleButton.tile:checked /template/ ContentPresenter, ToggleButton.tile:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.tile:checked TextBlock.secondary">
    <Setter Property="Foreground" Value="#E6FFFFFF" />
  </Style>
  <Style Selector="Button.tile.pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
  </Style>

  <!-- Small round icon button (favorites, back, clear) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="Button.icon.on">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>

  <!-- Folder chips -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{StaticResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="ListBox.rail">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#18FFFFFF" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#2E8B7CFF" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Status dot -->
  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="Ellipse.status.connected">
    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
  </Style>

  <!-- Int stepper buttons -->
  <Style Selector="Button.step">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.step:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Favorite star overlay -->
  <Style Selector="Button.star">
    <Setter Property="Padding" Value="6" />
  </Style>

  <!-- Edit mode -->
  <Style Selector="Button.editHit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#55FFFFFF" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.editHit:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1A8B7CFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#CC1C2030" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.mini.off">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.hiddenBadge">
    <Setter Property="Background" Value="#CC000000" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.editBanner">
    <Setter Property="Background" Value="#228B7CFF" />
    <Setter Property="BorderBrush" Value="#558B7CFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="ToggleButton.editToggle">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.editToggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
  </Style>
  <Style Selector="Button.railAction">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.railAction.armed /template/ ContentPresenter">
    <Setter Property="Background" Value="#55FF5D73" />
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- Rail details -->
  <Style Selector="Border.railIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Control).dim">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.pageIcon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="8,6,0,2" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- Editor sheets -->
  <Style Selector="Button.scrim">
    <Setter Property="Background" Value="#99000000" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.scrim:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Width" Value="600" />
    <Setter Property="MaxHeight" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#F2181B27" />
    <Setter Property="BoxShadow" Value="0 20 60 0 #80000000" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.chip.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
  </Style>
  <Style Selector="Button.chip.danger">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.swatch.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#2E8B7CFF" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="26,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="#F0222838" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="Opacity" Value="0" />
    <Style.Animations>
      <Animation Duration="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
